# ─── Supabase ─────────────────────────────────────────────────
# Setup steps (do once):
#  1. supabase.com → New project → wait ~1 min
#  2. SQL Editor → paste contents of database-setup.sql → Run
#  3. Settings → API → copy "Project URL" and "service_role" secret
#  4. Create .env.local in Codespace with the two values below
#  5. Run: npm install && npm run db:seed
#  6. Run: npm run dev
#
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Tag Manager ───────────────────────────────────────
# GTM container ID — loaded after cookie consent
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Google Analytics 4 ───────────────────────────────────────
# Add this inside your GTM container's GA4 tag (not loaded directly)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
