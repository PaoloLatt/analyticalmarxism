# ─── Database ─────────────────────────────────────────────────
# Local development — SQLite
DATABASE_URL="file:./prisma/dev.db"

# Production (Vercel) — PostgreSQL via Neon (https://neon.tech, free tier)
# 1. Create a Neon account + project
# 2. Copy the connection string from the Neon dashboard
# 3. Add it as DATABASE_URL in Vercel → Settings → Environment Variables
# 4. In prisma/schema.prisma change:  provider = "sqlite"  →  provider = "postgresql"
#    and:  url = "file:./prisma/dev.db"  →  url = env("DATABASE_URL")
# DATABASE_URL="postgresql://user:pass@host.neon.tech/dbname?sslmode=require"

# ─── Google Tag Manager ───────────────────────────────────────
# GTM container ID — script only loads after cookie consent.
# Get from https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Google Analytics 4 ───────────────────────────────────────
# GA4 is wired through GTM — add this Measurement ID inside your
# GTM container's GA4 Configuration tag (not loaded directly).
# Get from https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
