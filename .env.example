# ─── Database (PostgreSQL via Supabase) ───────────────────────
# The project uses PostgreSQL. Get a free database at https://supabase.com
#
# Steps (do once in GitHub Codespaces AND in Vercel):
#   1. supabase.com → New project → wait ~1 min for provisioning
#   2. Project Settings → Database → Connection string → "URI" tab
#      Copy the string — it looks like:
#      postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres
#   3. Paste it below (Codespace) or in Vercel → Settings → Environment Variables (production)
#
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Google Tag Manager ───────────────────────────────────────
# GTM container ID — script only loads after cookie consent.
# Get from https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Google Analytics 4 ───────────────────────────────────────
# GA4 is wired through GTM — add this Measurement ID inside your
# GTM container's GA4 Configuration tag (not loaded directly).
# Get from https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
