# ─── Database ─────────────────────────────────────────────────
# SQLite (default). Change provider + URL for PostgreSQL in production.
DATABASE_URL="file:./prisma/dev.db"

# ─── Google Tag Manager ───────────────────────────────────────
# GTM container ID — the script only loads after cookie consent.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Google Analytics 4 ───────────────────────────────────────
# GA4 is managed through GTM (not loaded directly).
# Add this ID inside your GTM container's GA4 Configuration tag.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
